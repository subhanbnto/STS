# Telegram (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
# Channel: use @username for public channels, or numeric ID for private (e.g. -1001234567890)
# Run: python list_telegram_chats.py  to find the ID of a private channel you're in
TELEGRAM_CHANNEL=@your_signal_channel

# WEEX Contract / Futures (create at https://www.weex.com/account/newapi)
# Need: API Key, Secret Key, and Passphrase (save passphrase when creating)
WEEX_API_KEY=your_weex_api_key
WEEX_SECRET_KEY=your_weex_secret_key
WEEX_PASSPHRASE=your_weex_passphrase

# Optional: OpenAI API key for AI signal parsing (understands "dont pick old signal" etc.; leave unset for rule-based only)
# OPENAI_API_KEY=sk-...

# Optional: default position size in USDT per trade
DEFAULT_POSITION_SIZE_USDT=10

# Optional: default leverage
DEFAULT_LEVERAGE=5

# Optional: use isolated margin only for USDT-M futures (1=yes, 0=no). Default 1.
WEEX_ISOLATED_MARGIN=1

# Dashboard login (single user; required to view http://localhost:5050)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password
FLASK_SECRET_KEY=use_a_long_random_string_here


OPENAI_API_KEY=sk-...